{
  "name": "syvis",
  "version": "0.0.0",
  "description": "Forget syntax highlighting. Syntax visualization is the real deal!",
  "main": "source/index.js",
  "bin": "source/cli.js",
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "test": "yarn lint",
    "postinstall": "cp node_modules/shaven/shaven.js public"
  },
  "keywords": [
    "syntax",
    "highlighting",
    "visualizing"
  ],
  "author": "Adrian Sieber",
  "license": "UNLICENSED",
  "private": "true",
  "dependencies": {
    "brfs": "^1.4.3",
    "browserify": "^15.2.0",
    "browserify-middleware": "^8.0.0",
    "esprima": "^4.0.0",
    "express": "^4.16.2",
    "morgan": "^1.9.0",
    "serve-favicon": "^2.4.5",
    "shaven": "1.2.0",
    "stylus": "^0.54.5",
    "whatwg-url": "^6.4.0"
  },
  "devDependencies": {
    "babel-minify": "^0.2.0",
    "eslint": "^4.16.0",
    "eslint-config-javascript": "^1.3.0"
  },
  "eslintConfig": {
    "extends": "eslint-config-javascript"
  },
  "browserify": {
    "transform": [
      "brfs"
    ]
  }
}
