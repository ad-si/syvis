*
  margin 0
  padding 0
  border 0

body
  color mutedColor
  font-size 12px
  font-family sans-serif
  background-color backgroundColor

  > main
    width 50em
    padding 2em 1em 5em 1em
    margin 0 auto

    > header > div
      display: flex
      justify-content: space-between
      align-items: center

h1
  font-size 3em
  margin-bottom 0.5em

h2
  margin-bottom 1em

p
  margin-bottom 0.5em

hr
  border-top 1px
  border-style solid
  border-color silentColor
  margin 1em 0

inputControl()
  border-width 1px
  border-style solid
  border-radius 0.5em
  border-color silentColor
  padding 0.5em 1em
  background-color backgroundColor
  font-family inherit
  font-size inherit
  color inherit

form#fileUrl
  display flex
  gap 0.5em

  input[type=text]
    inputControl()
    flex 1 1 auto
    min-width 0

  button
    inputControl()
    cursor pointer

form#codePaste
  display flex
  flex-direction column
  gap 0.5em
  align-items flex-start

  textarea
    inputControl()
    width 100%
    font-family monospace
    box-sizing border-box
    resize vertical

  button
    inputControl()
    cursor pointer

form#formForExample
  display flex
  flex-wrap wrap
  gap 0.75em

  label
    display inline-flex
    align-items center
    cursor pointer
    user-select none

  input[type=radio]
    cursor pointer
    margin-right 0.35em
    margin-top 0
    margin-bottom 0

.controls
  margin 1em 0 1.5em 0

  > .tab-input
    display none

  > .tab-labels
    display flex
    gap 0.25em
    border-bottom 1px solid silentColor
    margin-bottom 1em

    label
      padding 0.5em 1em
      cursor pointer
      border 1px solid transparent
      border-bottom none
      border-radius 0.5em 0.5em 0 0
      margin-bottom -1px
      user-select none
      color quietColor

      &:hover
        color primaryColor

  > .tab-panels > .tab-panel
    display none

  > #inputTabExample:checked ~ .tab-labels > label[for=inputTabExample]
  > #inputTabUrl:checked ~ .tab-labels > label[for=inputTabUrl]
  > #inputTabPaste:checked ~ .tab-labels > label[for=inputTabPaste]
    border-color silentColor
    border-bottom-color backgroundColor
    color primaryColor
    background-color backgroundColor

  > #inputTabExample:checked ~ .tab-panels > .panel-example
  > #inputTabUrl:checked ~ .tab-panels > .panel-url
  > #inputTabPaste:checked ~ .tab-panels > .panel-paste
    display block

.theme-selector
  display flex
  align-items center
  flex-wrap wrap
  gap 0.75em
  margin-top 1em
  padding-top 0.75em
  border-top 1px solid silentColor

  > span
    color quietColor

  label
    display inline-flex
    align-items center
    cursor pointer
    user-select none

  input[type=radio]
    cursor pointer
    margin-right 0.35em
    margin-top 0
    margin-bottom 0

